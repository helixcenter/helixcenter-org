---
pagination:
  data: speakers
  size: 1
  alias: speaker
permalink: "/speakers/{{ speaker.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ speaker.name }}"
  pageTitle: "{{ speaker.name }}"
  description: "{{ speaker.name }}{% if speaker.institution and speaker.institution != 'Unknown' %} — {{ speaker.institution }}{% endif %}{% if speaker.achievement %}. {{ speaker.achievement | truncate(120) }}{% endif %}"
  breadcrumbSection: "Speakers"
  breadcrumbPage: "{{ speaker.name }}"
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "{{ site.url }}/speakers/{{ speaker.slug }}/#person",
  "name": "{{ speaker.name }}",
  "url": "{{ site.url }}/speakers/{{ speaker.slug }}/",
  {% if speaker.title %}"jobTitle": "{{ speaker.title }}",{% endif %}
  {% if speaker.institution and speaker.institution != "Unknown" %}"worksFor": { "@type": "Organization", "name": "{{ speaker.institution }}" },{% endif %}
  {% if speaker.bio %}"description": "{{ speaker.bio | truncate(300) | jsonEscape }}",{% endif %}
  {% if speaker.photo %}"image": "{{ speaker.photo }}",{% endif %}
  {% if speaker.domain %}"knowsAbout": "{{ speaker.domain }}",{% endif %}
  {% if speaker.achievement %}"award": "{{ speaker.achievement | jsonEscape }}",{% endif %}
  {% if speaker.wikipedia or speaker.website or speaker.googleScholar or speaker.github %}"sameAs": [{% if speaker.wikipedia %}"{{ speaker.wikipedia }}"{% endif %}{% if speaker.website %}{% if speaker.wikipedia %},{% endif %}"{{ speaker.website }}"{% endif %}{% if speaker.googleScholar %}{% if speaker.wikipedia or speaker.website %},{% endif %}"{{ speaker.googleScholar }}"{% endif %}{% if speaker.github %}{% if speaker.wikipedia or speaker.website or speaker.googleScholar %},{% endif %}"{{ speaker.github }}"{% endif %}],{% endif %}
  "memberOf": {
    "@type": "EducationalOrganization",
    "@id": "{{ site.url }}/#organization"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}/speakers/{{ speaker.slug }}/"
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".speaker-bio", ".speaker-meta", "h1"]
  }
}
</script>

<div class="page-header">
  <div class="container">
    <div class="section-label">Speaker Profile{% if speaker.roundtables and speaker.roundtables.length %} &middot; {{ speaker.appearances }} appearance{% if speaker.appearances != 1 %}s{% endif %}{% endif %}</div>
    <h1>{{ speaker.name }}</h1>
    <div class="gold-divider"></div>
    {% if speaker.title %}
    <p class="section-subtitle">{{ speaker.title }}</p>
    {% elif speaker.institution and speaker.institution != "Unknown" %}
    <p class="section-subtitle">{{ speaker.institution }}</p>
    {% endif %}
  </div>
</div>

<div class="breadcrumbs">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/speakers/">Speakers</a></li>
    <li>{{ speaker.name }}</li>
  </ol>
</div>

<section class="detail-page">
  <div class="container">
    <div class="speaker-detail-header">
      {% if speaker.photo %}
      <img src="{{ speaker.photo }}" alt="{{ speaker.name }}" class="speaker-photo" loading="lazy" width="400" height="400"{% if speaker.photoPosition %} style="object-position: {{ speaker.photoPosition }}"{% endif %}>
      {% else %}
      <div class="speaker-detail-avatar">{{ speaker.name | initials }}</div>
      {% endif %}
      <div class="speaker-detail-info">
        <div class="speaker-detail-name">{{ speaker.name }}</div>
        <div class="speaker-meta">
          {% if speaker.title %}<p><strong>Title:</strong> {{ speaker.title }}</p>{% endif %}
          {% if speaker.institution and speaker.institution != "Unknown" %}<p><strong>Institution:</strong> {{ speaker.institution }}</p>{% endif %}
          <p><strong>Discipline:</strong> {{ speaker.domain }}</p>
          <p><strong>Appearances:</strong> {{ speaker.appearances }}</p>
          {% if speaker.achievement %}<p><strong>Notable:</strong> {{ speaker.achievement }}</p>{% endif %}
        </div>
        {% if speaker.wikipedia or speaker.website or speaker.googleScholar or speaker.github %}
        <div class="speaker-external-links">
          {% if speaker.wikipedia %}
          <a href="{{ speaker.wikipedia }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12.09 13.119c-.936 1.932-2.217 4.548-2.853 5.728-.616 1.074-1.127.914-1.661 0-.347-.58-4.91-11.252-5.225-12.035-.313-.782-.636-1.368-.29-1.368h2.356c.545 0 .636.326.834.865.456 1.262 2.654 6.773 3.137 7.846.14-.272 1.02-2.05 1.95-4.023.272-.58.303-.762.069-1.29C9.86 7.58 9.299 6.255 8.908 5.444c-.326-.672-.443-.983.223-.983h2.356c.476 0 .665.183.852.659l2.2 5.615 2.136-5.595c.183-.477.399-.68.853-.68h2.232c.476 0 .636.399.333 1.054l-3.53 7.226c.55 1.128 2.79 6.252 3.365 7.488.274.585-.196.893-.634.543-.395-.316-2.11-3.036-3.023-5.034-.335.67-1.07 2.142-1.748 3.381z"/></svg>
            Wikipedia
          </a>
          {% endif %}
          {% if speaker.website %}
          <a href="{{ speaker.website }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Website
          </a>
          {% endif %}
          {% if speaker.googleScholar %}
          <a href="{{ speaker.googleScholar }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
            Google Scholar
          </a>
          {% endif %}
          {% if speaker.github %}
          <a href="{{ speaker.github }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>

    {% if speaker.bio %}
    <div class="speaker-bio">
      <div class="speaker-bio-label">Biography</div>
      <p>{{ speaker.bio }}</p>
    </div>
    {% endif %}

    {% if speaker.sampleWorks and speaker.sampleWorks.length %}
    <div class="speaker-bio">
      <div class="speaker-bio-label">Sample Works</div>
      <ul class="sample-works-list">
        {% for work in speaker.sampleWorks %}
        <li>
          {% if work.url %}<a href="{{ work.url }}" target="_blank" rel="noopener">{{ work.title }}</a>{% else %}{{ work.title }}{% endif %}
          {% if work.year %}<span class="work-year">({{ work.year }})</span>{% endif %}
          {% if work.type %}<span class="work-type">{{ work.type }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if speaker.roundtables and speaker.roundtables.length %}
    <h2>Roundtable Appearances</h2>
    <div class="listing-grid" style="margin-top: 1.5rem;">
      {% for rtTitle in speaker.roundtables %}
      {% set matchedRt = roundtables | find('title', rtTitle) %}
      {% if matchedRt %}
      {% set rt = matchedRt %}
      {% include "partials/roundtable-card.njk" %}
      {% else %}
      <div class="rt-card">
        <div class="rt-title">{{ rtTitle }}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <div style="margin-top: 3rem; text-align: center;">
      <a href="/speakers/" class="btn btn-outline-dark">&larr; Back to All Speakers</a>
    </div>
  </div>
</section>
