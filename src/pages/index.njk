</div>

{% for award in awards %}
<template id="modal-{{ award.id }}">
  <div class="stat-modal-header">
    <h3>{{ award.name }}</h3>
    <p class="stat-modal-subtitle">{{ award.subtitle }}</p>
  </div>
  <div class="stat-modal-list">
    {% for speakerName in award.speakers %}
    {#- requireSpeaker (not findSpeaker): an award name that does not resolve is a
        data bug. It used to be swallowed by an `{% if sp %}` guard, which is how
        the "4 Nobel Laureates" card came to list only 2 people. Now it fails the build. -#}
    {% set sp = speakers | requireSpeaker(speakerName, "index.njk award modal: " + award.id) %}
    <a href="{{ sp.name | speakerUrl }}" class="stat-modal-person">
      {% if sp.photo %}<img src="{{ sp.photo }}" alt="{{ sp.name }}" class="stat-modal-photo">{% else %}<div class="stat-modal-initials">{{ sp.name | initials }}</div>{% endif %}
      <div>
        <div class="stat-modal-name">{{ sp.name }}</div>
        <div class="stat-modal-role">{{ sp.achievement }}</div>
        <div class="stat-modal-inst">{% if sp.institution and sp.institution != "Unknown" %}{{ sp.institution }}{% endif %}</div>
      </div>
    </a>
    {% endfor %}
  </div>
</template>
{% endfor %}

