          <div class="video-desc">{{ featuredRt.description | truncate(220) }}</div>
          <div class="video-meta">{{ featuredRt.date | eventWeekday }}, {{ featuredRt.date | eventMonth }} {{ featuredRt.date | eventDay }}, {{ featuredRt.date | eventYear }} &middot; {{ featuredRt.date | eventTime }} EST &middot; Free admission</div>
        </div>
      </div>
      {%- endif %}

