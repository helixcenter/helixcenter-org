<!-- FEATURED SPEAKERS -->
<section id="speakers" class="fade-in">
  <div class="container">
    <div class="section-label text-center">Distinguished Participants</div>
    <h2 class="text-center">Featured Speakers</h2>
    <div class="gold-divider"></div>
    <p class="section-subtitle text-center">
      From a community of {{ stats.speakers }} scholars, scientists, and artists across {{ stats.institutions }} leading institutions,
      these are among our most distinguished participants.
      <span style="display: block; margin-top: 0.35rem; font-size: 0.85rem; color: var(--text-light); font-style: normal;">Roundtables curated by <a href="/speakers/edward-nersessian/" style="color: var(--gold-dark); text-decoration: none;">Dr. Edward Nersessian</a>, Founder &amp; Director</span>
    </p>
    <div class="speakers-grid">
      {% for speaker in speakers | sortBy('score', 'desc') | limit(12) %}
      {% set s = speaker %}
      {% include "partials/speaker-card.njk" %}
      {% endfor %}
    </div>
    <div class="text-center" style="margin-top: 2.5rem;">
      <a href="/speakers/" class="btn btn-outline-dark">View All {{ stats.speakers }} Speakers &rarr;</a>
    </div>
  </div>
</section>

<!-- INSTITUTIONS BAR -->
<section class="warm" style="padding: 2.5rem 0;">
  <div class="container text-center">
    <div class="section-label text-center">Our Speakers Come From</div>
    <div class="marquee-wrapper">
      <div class="marquee-track">
        {% for inst in institutions | sortBy('marqueeOrder') %}{% if inst.marquee %}
        <a href="/institutions/{{ inst.slug }}/" class="inst-logo {{ inst.style }}"{% if inst.css %} style="{{ inst.css }}"{% endif %}>{{ inst.shortName }}</a>
        {% endif %}{% endfor %}
        {# duplicate set for seamless loop #}
        {% for inst in institutions | sortBy('marqueeOrder') %}{% if inst.marquee %}
        <a href="/institutions/{{ inst.slug }}/" class="inst-logo {{ inst.style }}"{% if inst.css %} style="{{ inst.css }}"{% endif %}>{{ inst.shortName }}</a>
        {% endif %}{% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- FEATURED ROUNDTABLES / VIDEO SHOWCASE -->
<section id="roundtables" class="fade-in">
  <div class="container">
    <div class="section-label text-center">Watch</div>
    <h2 class="text-center">Featured Roundtable Discussions</h2>
    <div class="gold-divider"></div>
    <p class="section-subtitle text-center">
      A curated selection from over {{ stats.roundtables }} archived discussions &mdash; every one free to watch.
    </p>

    {#- Both cards are data-driven. The featured card previously hard-coded
        "Medicine and AI / April 18" and kept advertising it as upcoming long after
        the event; it now tracks whatever `nextUpcoming` returns, and is simply
        omitted when nothing is scheduled. -#}
    {%- set featuredRt = roundtables | nextUpcoming %}
    {%- set latestVideoRt = roundtables | latestVideo %}
    <div class="video-grid">
      {%- if featuredRt %}
      <div class="video-card featured">
        <div class="video-thumbnail" style="padding-top:0;">
          <img src="{{ featuredRt.imageFile }}" alt="{{ featuredRt.title }} — upcoming Helix Center roundtable" style="width:100%; height:100%; object-fit:cover; display:block; aspect-ratio:16/9;">
          <a href="/roundtables/{{ featuredRt.slug }}/" style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; background:linear-gradient(transparent 40%, rgba(10,22,40,0.7)); text-decoration:none; padding:1.5rem;">
