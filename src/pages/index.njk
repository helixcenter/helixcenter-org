          <li>Subscribe for notifications of upcoming events</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- UPCOMING EVENT -->
{#- Data-driven, not hard-coded. `nextUpcoming` requires BOTH status "Future Event"
    and a date >= today, so a stale status can never re-advertise a past event as
    upcoming (the previous hard-coded block still showed "Medicine and AI",
    April 18 2026, five months after the fact). Falls back to the latest past
    roundtable with "Watch the latest" framing when nothing is scheduled. -#}
{%- set upcomingRt = roundtables | nextUpcoming %}
{%- set isUpcoming = upcomingRt %}
{%- if not upcomingRt %}{% set upcomingRt = roundtables | latestPast %}{% endif %}
{%- if upcomingRt %}
<section id="upcoming" class="fade-in">
  <div class="container">
    <div class="section-label text-center">{% if isUpcoming %}Next Event{% else %}Most Recent{% endif %}</div>
    <h2 class="text-center">{% if isUpcoming %}Upcoming Roundtable{% else %}Watch the Latest Roundtable{% endif %}</h2>
    <div class="gold-divider"></div>

    <div class="upcoming-event">
      <div>
        <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">{{ upcomingRt.title }}</h3>
        <p style="font-family: var(--serif); font-size: 1.02rem; color: var(--text-mid); line-height: 1.75; margin-bottom: 1.5rem;">
          {{ upcomingRt.description | truncate(340) }}
        </p>
        <p style="font-size: 0.9rem; color: var(--text-mid); margin-bottom: 0.35rem;">
          <strong>Location:</strong> {{ site.address.venue }}<br>
          {{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}
        </p>
        <p style="font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.5rem;">
          {% if isUpcoming %}Free and open to the public &middot; Live stream available{% else %}Free to watch &middot; Archived in full{% endif %}
        </p>
        <div style="text-align: center;">
          <a href="/roundtables/{{ upcomingRt.slug }}/" class="btn btn-gold">{% if isUpcoming %}Learn More{% else %}Watch Now{% endif %}</a>
        </div>
      </div>
      <div class="event-date">
        <div class="event-month">{{ upcomingRt.date | eventMonth }}</div>
        <div class="event-day">{{ upcomingRt.date | eventDay }}</div>
        <div class="event-month">{{ upcomingRt.date | eventYear }}</div>
        <div class="event-time">{{ upcomingRt.date | eventWeekday }} &middot; {{ upcomingRt.date | eventTime }}</div>
      </div>
    </div>
  </div>
</section>
{%- endif %}

