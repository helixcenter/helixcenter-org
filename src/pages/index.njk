          <div class="video-title">{{ latestVideoRt.title }}</div>
          <div class="video-desc">{{ latestVideoRt.description | truncate(220) }}</div>
        </div>
      </div>
      {%- endif %}

      <div class="video-card">
        <div class="video-thumbnail">
          <iframe width="640" height="360" src="https://www.youtube-nocookie.com/embed/RPAe8sa6TGo?rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy" title="Resurgence of Freud — Helix Center Roundtable"></iframe>
        </div>
        <div class="video-info">
          <div class="video-topic">Neuroscience &middot; September 2025</div>
          <div class="video-title">Resurgence of Freud</div>
          <div class="video-desc">Reconsidering psychoanalytic theory in light of advances in brain biology and psychotropic medication.</div>
        </div>
      </div>
    </div>

    <div class="text-center" style="margin-top: 2.5rem;">
      <a href="/roundtables/" class="btn btn-outline-dark">Browse Full Archive &rarr;</a>
    </div>
  </div>
</section>

