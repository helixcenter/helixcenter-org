---
layout: layouts/base.njk
title: Interdisciplinary Roundtable Discussions in NYC
pageTitle: Where the World's Leading Minds Converge
permalink: /
eleventyComputed:
  # Computed, not a literal string: front matter is not template-processed, and
  # the hard-coded "507 scholars / 13 disciplines" here had gone stale.
  description: "The Helix Center hosts free interdisciplinary roundtable discussions bringing together Nobel laureates, MacArthur Fellows, and {{ stats.speakers }} distinguished scholars across {{ stats.disciplines }} disciplines. Founded 2012 in New York City."
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": "{{ site.url }}/#organization",
  "name": "{{ site.name }}",
  "alternateName": ["The Helix Center", "Helix Center"],
  "url": "{{ site.url }}/",
  "logo": {
    "@type": "ImageObject",
    "url": "{{ site.url }}/img/helix-center-og.jpg"
  },
  {#- Use the computed page description (stats-driven), not site.json's literal,
      which still hard-codes the stale "507 scholars / 13 disciplines". -#}
  "description": "{{ description | jsonEscape }}",
  "foundingDate": "2012-01-01",
  "founder": {
    "@type": "Person",
    "@id": "{{ site.url }}/speakers/edward-nersessian/#person",
    "name": "{{ site.founder }}",
    "jobTitle": "Founder & Director"
  },
  "nonprofitStatus": "Nonprofit501c3",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.street }}",
    "addressLocality": "{{ site.address.city }}",
    "addressRegion": "{{ site.address.state }}",
    "postalCode": "{{ site.address.zip }}",
    "addressCountry": "US"
  },
  "sameAs": [
    "{{ site.social.facebook }}",
    "{{ site.social.twitter }}",
    "{{ site.social.youtube }}",
    "{{ site.social.instagram }}",
    "{{ site.social.linkedin }}",
    "{{ site.social.podcast }}",
    "{{ site.social.wikidata }}"
  ],
  "knowsAbout": [
    "Neuroscience", "Philosophy", "Physics", "Psychology", "Literature",
    "Mathematics", "Biology", "Technology", "Arts", "Sociology",
    "Psychoanalysis", "Cosmology", "Poetry"
  ],
  "isAccessibleForFree": true,
  "areaServed": { "@type": "City", "name": "New York" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "@id": "{{ site.url }}/#eventseries",
  "name": "The Helix Center Roundtable Discussions",
  "description": "Free, public interdisciplinary roundtable discussions bringing together five distinguished participants from different fields for unrehearsed intellectual exchange.",
  "organizer": { "@id": "{{ site.url }}/#organization" },
  "location": {
    "@type": "Place",
    "name": "{{ site.address.venue }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.city }}",
      "addressRegion": "{{ site.address.state }}",
      "postalCode": "{{ site.address.zip }}",
      "addressCountry": "US"
    }
  },
  "startDate": "2012-01-01",
  "isAccessibleForFree": true
}
</script>
{% if speakers | length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [{% for speaker in speakers | sortBy('score', 'desc') | limit(8) %}{% if loop.index0 > 0 %},{% endif %}
    {
      "@type": "Person",
      "@id": "{{ site.url }}/speakers/{{ speaker.slug }}/#person",
      "name": "{{ speaker.name }}",
      "url": "{{ site.url }}/speakers/{{ speaker.slug }}/",
      {% if speaker.title %}"jobTitle": "{{ speaker.title }}",{% endif %}
      {% if speaker.institution and speaker.institution != "Unknown" %}"worksFor": { "@type": "Organization", "name": "{{ speaker.institution }}" },{% endif %}
      {% if speaker.bio %}"description": "{{ speaker.bio | truncate(200) | jsonEscape }}",{% endif %}
      {% if speaker.achievement %}"award": "{{ speaker.achievement | jsonEscape }}",{% endif %}
      {% if speaker.wikipedia %}"sameAs": ["{{ speaker.wikipedia }}"],{% endif %}
      "memberOf": { "@id": "{{ site.url }}/#organization" }
    }{% endfor %}
  ]
}
</script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ site.url }}/#website",
  "name": "{{ site.shortName }}",
  "url": "{{ site.url }}/",
  "publisher": { "@id": "{{ site.url }}/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.url }}/speakers/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "inLanguage": "en"
}
</script>

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <div class="section-label">{{ site.name }}</div>
      <h1>Where the World's Leading Minds <span class="gold">Converge</span></h1>
      <p class="hero-tagline">
        A university without walls &mdash; drawing together Nobel laureates, MacArthur Fellows,
        and pioneering thinkers from every discipline for unrehearsed intellectual exchange.
      </p>
      <p class="hero-description">
        Since 2012, The Helix Center has hosted {{ stats.speakers }} of the world's most distinguished scholars,
        scientists, artists, and public intellectuals for free interdisciplinary roundtable discussions
        at the {{ site.address.venue }} on Manhattan's Upper East Side. Every event
        is free, open to the public, and archived for the world.
      </p>
      <div class="hero-cta">
        <a href="/roundtables/" class="btn btn-gold">See Upcoming Roundtables</a>
        <a href="/roundtables/" class="btn btn-outline">Watch Past Discussions</a>
      </div>
    </div>
    <div class="hero-stats hero-stats-3col">
      {% for award in awards %}
      <div class="stat-card stat-card-clickable" data-stat-modal="{{ award.id }}">
        <div class="stat-number">{{ award.count }}</div>
        <div class="stat-label">{{ award.label }}</div>
        <div class="stat-detail">{{ award.detail }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="hero-distinctions-link">
      <a href="/awards/">And many other distinguished speakers&hellip;</a>
    </div>
  </div>
</section>

<!-- IMPACT STRIP -->
<section class="dark" style="padding: 0;">
  <div class="container">
    <div class="impact-strip">
      <div class="impact-item">
        <div class="impact-number">{{ stats.speakers }}</div>
        <div class="impact-label">Speakers</div>
      </div>
      <div class="impact-item">
        <div class="impact-number">{{ stats.seasons }}</div>
        <div class="impact-label">Years</div>
      </div>
      <div class="impact-item">
        <div class="impact-number">{{ stats.roundtables }}</div>
        <div class="impact-label">Roundtables</div>
      </div>
      <div class="impact-item">
        <div class="impact-number">{{ stats.institutions }}</div>
        <div class="impact-label">Institutions</div>
      </div>
      <div class="impact-item">
        <div class="impact-number">$0</div>
        <div class="impact-label">Admission</div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT / MISSION -->
<section id="about" class="cream fade-in">
  <div class="container">
    <div class="section-label">Our Mission</div>
    <h2>A Rare Space for Curiosity, Wonder, and Rigorous Exchange</h2>
    <div class="gold-divider" style="margin-left:0;"></div>
    <div class="mission-grid">
      <div class="mission-text">
        <p>
          The Helix Center for Interdisciplinary Investigation was founded in 2012 by
          <strong>{{ site.founder }}</strong>, a psychoanalyst who observed how narrow specialization
          and the grant process were constraining creativity at professional scientific meetings.
          What began as an experiment in <span class="highlight">"a university without walls"</span>
          has grown into one of New York City's most distinctive intellectual institutions.
        </p>
        <p>
          Over {{ stats.seasons }} seasons, The Helix Center has convened <strong>{{ stats.speakers }} distinguished speakers</strong>
          from <strong>{{ stats.institutions }} institutions</strong> &mdash; including Columbia, NYU, Princeton, Yale, Harvard,
          MIT, Oxford, Cambridge, and University College London &mdash; for its signature
          <strong>Theaetetus Table</strong> roundtable discussions. These extempore (unscripted) conversations
          bring five experts from different fields together to explore a single question at the boundaries
          of human knowledge.
        </p>
        <p>
          Every event is completely free and open to the public &mdash; an act of intellectual generosity
          made possible by donors who believe in the enduring value of cross-disciplinary inquiry.
        </p>
      </div>
      <div class="mission-principles">
        <div class="principle">
          <div class="principle-icon">&#8734;</div>
          <div>
            <h4>Interdisciplinary by Design</h4>
            <p>Every roundtable unites voices from multiple fields &mdash; {{ stats.disciplines }} disciplines from neuroscience to poetry, physics to psychoanalysis.</p>
          </div>
        </div>
        <div class="principle">
          <div class="principle-icon">&#9733;</div>
          <div>
            <h4>Exceptional Caliber</h4>
            <p>Our {{ stats.speakers }} speakers include {{ stats.nobelLaureates }} Nobel laureates, {{ stats.macarthurFellows }} MacArthur Fellows, National Medal of Science recipients, and the most-cited neuroscientist in history.</p>
          </div>
        </div>
        <div class="principle">
          <div class="principle-icon">&#9881;</div>
          <div>
            <h4>Unrehearsed &amp; Authentic</h4>
            <p>No scripts, no pre-arranged positions. Five scholars sit together and think out loud. The result is genuine intellectual discovery.</p>
          </div>
        </div>
        <div class="principle">
          <div class="principle-icon">&#9825;</div>
          <div>
            <h4>Free &amp; Open to All</h4>
            <p>Every event &mdash; in person or via live stream &mdash; is free. Our entire {{ stats.roundtables }} roundtable archive is freely accessible online.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- THEAETETUS TABLE -->
