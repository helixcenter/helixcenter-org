<!-- INTELLECTUAL SALON / ARCHIVE -->
<section class="fade-in">
  <div class="container-narrow">
    <div class="section-label text-center">A Real &amp; Virtual Intellectual Salon</div>
    <h2 class="text-center">A Living Archive for Interdisciplinary Enquiry</h2>
    <div class="gold-divider"></div>
    <p class="section-subtitle text-center">
      Part intellectual salon, part open archive &mdash; The Helix Center is both a place where
      ideas are forged in real time and a growing library of over a decade of cross-disciplinary dialogue.
    </p>
    <p style="font-family: var(--serif); font-size: 1.02rem; color: var(--text-mid); line-height: 1.85; margin-top: 2rem; text-align: center;">
      In the tradition of the great European salons and the founding seminars of the Institute for
      Advanced Study, The Helix Center creates conditions for genuine intellectual surprise &mdash;
      where a neuroscientist's insight reframes a philosopher's question, where a poet's language
      unlocks a physicist's intuition. Our {{ stats.roundtables }} archived roundtables form an unparalleled resource
      for educators, researchers, students, and the intellectually curious public &mdash; spanning
      consciousness, AI and ethics, the nature of creativity, cosmology, memory, beauty, free will,
      psychoanalysis, mathematics, and far beyond.
    </p>

    <div class="ai-topics">
      <span class="ai-topic">Consciousness</span>
      <span class="ai-topic">Artificial Intelligence &amp; Ethics</span>
      <span class="ai-topic">Free Energy Principle</span>
      <span class="ai-topic">Nature of Creativity</span>
      <span class="ai-topic">Theory of Mind</span>
      <span class="ai-topic">Memory &amp; Forgetting</span>
      <span class="ai-topic">Philosophy of Mind</span>
      <span class="ai-topic">Cognitive Modeling</span>
      <span class="ai-topic">Neuroaesthetics</span>
      <span class="ai-topic">Behavioral Economics</span>
      <span class="ai-topic">Free Will &amp; Determinism</span>
      <span class="ai-topic">Literature &amp; Science</span>
      <span class="ai-topic">Psychoanalysis &amp; Neuroscience</span>
      <span class="ai-topic">Cosmology &amp; Physics</span>
      <span class="ai-topic">Decision Science</span>
      <span class="ai-topic">Beauty &amp; Aesthetics</span>
      <span class="ai-topic">Neurodiversity</span>
      <span class="ai-topic">Human-Machine Interaction</span>
    </div>
  </div>
</section>

