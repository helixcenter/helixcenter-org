---
layout: layouts/base.njk
title: Interdisciplinary Roundtable Discussions in NYC
pageTitle: Where the World's Leading Minds Converge
description: "The Helix Center hosts free interdisciplinary roundtable discussions bringing together Nobel laureates, MacArthur Fellows, and 506 distinguished scholars across 13 disciplines. Founded 2012 in New York City."
permalink: /
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": "https://www.helixcenter.org/#organization",
  "name": "{{ site.name }}",
  "alternateName": ["The Helix Center", "Helix Center"],
  "url": "{{ site.url }}/",
  "description": "{{ site.description }}",
  "foundingDate": "{{ site.founded }}",
  "founder": {
    "@type": "Person",
    "name": "{{ site.founder }}",
    "jobTitle": "Founder & Director"
  },
  "nonprofitStatus": "Nonprofit501c3",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.street }}",
    "addressLocality": "{{ site.address.city }}",
    "addressRegion": "{{ site.address.state }}",
    "postalCode": "{{ site.address.zip }}",
    "addressCountry": "US"
  },
  "sameAs": [
    "{{ site.social.facebook }}",
    "{{ site.social.twitter }}",
    "{{ site.social.youtube }}",
    "{{ site.social.instagram }}",
    "{{ site.social.linkedin }}"
  ],
  "isAccessibleForFree": true
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EventSeries",
  "name": "The Helix Center Roundtable Discussions",
  "description": "Free, public interdisciplinary roundtable discussions bringing together five distinguished participants from different fields for unrehearsed intellectual exchange.",
  "organizer": { "@id": "https://www.helixcenter.org/#organization" },
  "startDate": "2012-01-01",
  "isAccessibleForFree": true
}
</script>
{% if speakers | length %}
<script type="application/ld+json">
[{% for speaker in speakers | sortBy('score', 'desc') | limit(8) %}{% if loop.index0 > 0 %},{% endif %}
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ speaker.name }}",
    {% if speaker.title %}"jobTitle": "{{ speaker.title }}",{% endif %}
    {% if speaker.institution and speaker.institution != "Unknown" %}"worksFor": { "@type": "Organization", "name": "{{ speaker.institution }}" },{% endif %}
    {% if speaker.achievement %}"description": "{{ speaker.achievement }}",{% endif %}
    {% if speaker.wikipedia %}"sameAs": ["{{ speaker.wikipedia }}"]{% endif %}
  }{% endfor %}
]
</script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is The Helix Center?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Helix Center for Interdisciplinary Investigation is a 501(c)(3) nonprofit organization founded in 2012 in New York City. It hosts free, public interdisciplinary roundtable discussions called Theaetetus Tables that bring together five distinguished scholars from different fields for unrehearsed intellectual exchange."
      }
    },
    {
      "@type": "Question",
      "name": "Are Helix Center events free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all Helix Center events are completely free and open to the public. You can attend in person or watch via free live stream. All past roundtables are archived and freely accessible online."
      }
    },
    {
      "@type": "Question",
      "name": "What is a Theaetetus Table?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Theaetetus Table is The Helix Center's signature roundtable format, named for the Platonic dialogue investigating the nature of knowledge. Each Table seats five participants for extempore interdisciplinary discussion, symbolizing the five Platonic solids and cultivating curiosity, playfulness, inspiration, reflection, and wonder."
      }
    }
  ]
}
</script>

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <div class="section-label">{{ site.name }}</div>
      <h1>Where the World's Leading Minds <span class="gold">Converge</span></h1>
      <p class="hero-tagline">
        A university without walls &mdash; drawing together Nobel laureates, MacArthur Fellows,
        and pioneering thinkers from every discipline for unrehearsed intellectual exchange.
      </p>
      <p class="hero-description">
        Since 2012, The Helix Center has hosted {{ site.stats.speakers }} of the world's most distinguished scholars,
        scientists, artists, and public intellectuals for free interdisciplinary roundtable discussions
        at the {{ site.address.venue }} on Manhattan's Upper East Side. Every event
        is free, open to the public, and archived for the world.
      </p>
      <div class="hero-cta">
        <a href="/roundtables/where-have-all-the-isms-gone-on-the-evolution-of-knowledge/" class="btn btn-gold">Attend Our Next Roundtable</a>
        <a href="/roundtables/" class="btn btn-outline">Watch Past Discussions</a>
      </div>
    </div>
    <div class="hero-stats hero-stats-3col">
      <div class="stat-card stat-card-clickable" data-stat-modal="nobel">
        <div class="stat-number">{{ site.stats.nobelLaureates }}</div>
        <div class="stat-label">Nobel Laureates</div>
        <div class="stat-detail">Kahneman &amp; Kandel</div>
      </div>
      <div class="stat-card stat-card-clickable" data-stat-modal="macarthur">
        <div class="stat-number">{{ site.stats.macarthurFellows }}</div>
        <div class="stat-label">MacArthur Fellows</div>
        <div class="stat-detail">"Genius Grant" recipients</div>
      </div>
      <div class="stat-card stat-card-clickable" data-stat-modal="nas">
        <div class="stat-number">5</div>
        <div class="stat-label">NAS Members</div>
        <div class="stat-detail">National Academy of Sciences</div>
      </div>
      <div class="stat-card stat-card-clickable" data-stat-modal="guggenheim">
        <div class="stat-number">13</div>
        <div class="stat-label">Guggenheim Fellows</div>
        <div class="stat-detail">John Simon Guggenheim Foundation</div>
      </div>
      <div class="stat-card stat-card-clickable" data-stat-modal="bestselling">
        <div class="stat-number">3</div>
        <div class="stat-label">Bestselling Authors</div>
        <div class="stat-detail">O'Neil, Kahneman, Suzuki</div>
      </div>
      <div class="stat-card stat-card-clickable" data-stat-modal="disciplines">
        <div class="stat-number">{{ site.stats.disciplines }}</div>
        <div class="stat-label">Disciplines</div>
        <div class="stat-detail">Sciences, arts, humanities</div>
      </div>
    </div>
  </div>
</section>

