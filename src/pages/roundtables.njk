---
layout: layouts/base.njk
title: Roundtable Discussions
pagination:
  data: roundtables
  size: 18
  alias: items
permalink: "/roundtables/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  pageTitle: "Roundtable Discussions{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %}"
  description: "Browse {{ roundtables | length }}+ interdisciplinary roundtable discussions from The Helix Center{% if pagination.pageNumber > 0 %} — page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}{% endif %}. Featuring Nobel laureates and {{ stats.speakers }} distinguished scholars. All free to watch."
  breadcrumbSection: "Roundtables"
---

{% set isFirstPage = pagination.pageNumber == 0 %}

{# Separate upcoming from past (for featured section on page 1) #}
{% set upcoming = [] %}
{% for rt in roundtables %}
  {% if rt.status and "Future" in rt.status %}
    {% set upcoming = (upcoming.push(rt), upcoming) %}
  {% endif %}
{% endfor %}
{% set rtWithVideo = roundtables | where("hasVideo", true) %}

{% if isFirstPage %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": "The Helix Center Roundtable Discussions",
  "url": "{{ site.social.podcast }}",
  "description": "Interdisciplinary roundtable discussions featuring Nobel laureates, MacArthur Fellows, and leading scholars across {{ stats.disciplines }} disciplines. {{ podcasts | length }} episodes spanning {{ stats.seasons }} seasons.",
  "webFeed": "{{ site.social.rss }}",
  "inLanguage": "en",
  "genre": ["Science", "Philosophy", "Interdisciplinary"],
  "publisher": { "@id": "{{ site.url }}/#organization" },
  "author": { "@id": "{{ site.url }}/#organization" },
  "numberOfEpisodes": {{ podcasts | length }},
  "sameAs": [
    "{{ site.social.podcast }}",
    "{{ site.social.youtube }}"
  ],
  "hasPart": [
    {% for ep in podcasts | limit(20) %}{% if loop.index0 > 0 %},{% endif %}
    {
      "@type": "PodcastEpisode",
      "name": "{{ ep.title | jsonEscape }}",
      {% if ep.date %}"datePublished": "{{ ep.date | toISODate }}",{% endif %}
      {% if ep.duration %}"timeRequired": "PT{{ ep.duration | replace(':', 'H') }}M",{% endif %}
      {% if ep.description %}"description": "{{ ep.description | truncate(200) | jsonEscape }}",{% endif %}
      "partOfSeries": { "@type": "PodcastSeries", "name": "The Helix Center Roundtable Discussions" }
    }{% endfor %}
  ]
}
</script>
{% endif %}

<div class="page-header">
  <div class="container">
    <div class="section-label">Explore</div>
    <h1>Roundtable Discussions</h1>
    <div class="gold-divider"></div>
    <p class="section-subtitle">{{ roundtables | length }} interdisciplinary discussions spanning {{ stats.seasons }} seasons, all free and open to the public</p>
  </div>
</div>

<div class="breadcrumbs">
  <ol><li><a href="/">Home</a></li><li>Roundtables</li></ol>
</div>

{% if isFirstPage and upcoming.length %}
<!-- Upcoming Roundtables -->
<section>
  <div class="container">
    <div class="section-label">Upcoming</div>
    <h2>Upcoming Roundtables</h2>
    <div class="gold-divider" style="margin-left: 0;"></div>

    <div class="upcoming-grid">
      {% for rt in upcoming %}
      <div class="upcoming-card">
        {% if rt.imageFile %}
        <a href="/roundtables/{{ rt.slug }}/" class="upcoming-card-image">
          <img src="{{ rt.imageFile }}" alt="{{ rt.title }}" width="800" height="450">
          {% if rt.hasVideo %}
          <div class="video-play-overlay">
            <span class="video-play-icon">&#9654;</span>
            <span class="video-play-label">Watch</span>
          </div>
          {% endif %}
        </a>
        {% endif %}
        <div class="upcoming-card-body">
          <div class="upcoming-card-date">{{ rt.date }}</div>
          <a href="/roundtables/{{ rt.slug }}/" class="upcoming-card-title-link">
            <h3 class="upcoming-card-title">{{ rt.title }}</h3>
          </a>
          {% if rt.description %}
          <p class="upcoming-card-desc">{{ rt.description | truncate(300) }}</p>
          {% endif %}
          {% if rt.speakers and rt.speakers.length %}
          <div class="upcoming-card-speakers">
            {% for speaker in rt.speakers %}
            <span class="upcoming-speaker-name">{{ speaker }}</span>{% if not loop.last %}<span class="upcoming-speaker-sep">&middot;</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}
          {% if rt.canonicalTopics and rt.canonicalTopics.length %}
          <div class="rt-tags" style="margin-top: 0.75rem;">
            {% for topic in rt.canonicalTopics | limit(5) %}
            {% set topicObj = topics | find('slug', topic) %}
            <a href="/roundtables/all/?topic={{ topic }}" class="rt-tag">{{ topicObj.name if topicObj else topic }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    <div style="text-align: center; margin-top: 1.5rem;">
      <a href="#" class="btn btn-gold register-btn" id="register-open-btn">Event Details</a>
    </div>
  </div>
</section>

<!-- Register Modal -->
<div class="register-modal-overlay" id="register-modal-overlay">
  <div class="stat-modal" style="max-width: 520px;">
    <button class="stat-modal-close register-modal-close">&times;</button>
    <div style="padding: 1.5rem;">
      <h2 style="font-family: var(--serif); font-size: 1.4rem; color: var(--navy); margin-bottom: 0.5rem;">Welcome!</h2>
      <p style="font-family: var(--serif); font-size: 0.95rem; color: var(--text-mid); line-height: 1.7; margin-bottom: 1.25rem;">
        All Helix Center Roundtables are <strong>free and open to the public</strong> on a first-come, first-served basis. No registration required — just show up!
      </p>

      {% set nextRt = upcoming[0] %}
      {% if nextRt %}
      <div style="background: var(--cream); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.25rem;">
        <div style="font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-dark); margin-bottom: 0.35rem;">Next Roundtable</div>
        <div style="font-family: var(--serif); font-size: 1.1rem; font-weight: 600; color: var(--navy); margin-bottom: 0.25rem;">{{ nextRt.title }}</div>
        <div style="font-size: 0.85rem; color: var(--text-mid);">{{ nextRt.date }}</div>
        <div style="font-size: 0.82rem; color: var(--text-light); margin-top: 0.15rem;">{{ site.address.venue }}, {{ site.address.street }}</div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <a href="#" class="btn btn-outline-dark" id="add-to-calendar-btn" style="font-size: 0.85rem; padding: 0.6rem 1.25rem;" data-title="{{ nextRt.title | jsonEscape }}" data-date="{{ nextRt.date }}" data-location="{{ site.address.venue }}, {{ site.address.street }}, {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}">
          &#128197; Add to Calendar
        </a>
      </div>
      {% endif %}

      <div style="border-top: 1px solid var(--border); padding-top: 1.25rem;">
        <p style="font-size: 0.88rem; color: var(--text-mid); margin-bottom: 0.75rem;">Get event reminders by email:</p>
        <form id="register-notify-form" name="event-notify" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="event-notify">
          <p class="hidden" style="display:none;"><label>Don't fill: <input name="bot-field"></label></p>
          <input type="email" name="email" id="register-email" placeholder="Your email address" required style="width: 100%; padding: 0.6rem 0.75rem; border: 2px solid var(--border); border-radius: var(--radius); font-size: 0.9rem; margin-bottom: 0.75rem; box-sizing: border-box;">
          <div id="register-email-error" style="display: none; color: #c0392b; font-size: 0.8rem; margin: -0.5rem 0 0.5rem;">Please enter a valid email address.</div>
          <button type="submit" class="btn btn-gold" style="padding: 0.6rem 1.5rem; font-size: 0.85rem;">Notify Me</button>
        </form>
        <div id="register-thank-you" style="display: none; text-align: center; padding: 0.75rem 0;">
          <p style="color: var(--gold-dark); font-weight: 600;">You're all set! We'll send you a reminder.</p>
        </div>
      </div>

      <div style="border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: 0.25rem;">
        <iframe src="https://maps.google.com/maps?q=247+E+82nd+St,+New+York,+NY+10028&t=&z=16&ie=UTF8&iwloc=&output=embed" width="100%" height="180" style="border:0; border-radius: var(--radius);" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p style="text-align: center; margin-top: 0.5rem;">
          <a href="https://www.google.com/maps/place/247+E+82nd+St,+New+York,+NY+10028/data=!4m2!3m1!1s0x89c258bc020ca443:0xa2812a396b4c9004?sa=X&ved=1t:242&ictx=111" target="_blank" rel="noopener" style="color: var(--gold-dark); font-size: 0.85rem; text-decoration: none;">Open map in new browser window &rarr;</a>
        </p>
      </div>
    </div>
  </div>
</div>
{% endif %}

<!-- Search & Filter Bar + Roundtable Cards -->
<section class="{% if isFirstPage and upcoming.length %}cream{% endif %}">
  <div class="container">
    <div class="filter-bar">
      <input type="text" id="search-input" placeholder="Search roundtables by title, topic, or speaker...">
      <select id="filter-select">
        <option value="">All Years</option>
        {% for year in roundtables | uniqueValues('year') | reverse %}
        <option value="{{ year }}">{{ year }}</option>
        {% endfor %}
      </select>
      <div class="sort-toggle">
        <a href="/roundtables/" class="sort-btn{% if isFirstPage %} active{% endif %}" style="text-decoration:none;">Recent</a>
        <select id="topic-filter" class="sort-btn">
          <option value="">All Topics</option>
          {% for topic in topics %}
          <option value="{{ topic.slug }}">{{ topic.name }} ({{ topic.count }})</option>
          {% endfor %}
        </select>
      </div>
    </div>

    {% if isFirstPage %}
    <div class="section-label" style="margin-top: 1.5rem;">Archive</div>
    <h2>Past Roundtables</h2>
    <div class="gold-divider" style="margin-left: 0;"></div>
    <p style="font-family: var(--serif); font-size: 1.02rem; color: var(--text-mid); margin-bottom: 1.5rem;">
      {{ rtWithVideo | length }} roundtable recordings on the <a href="{{ site.social.youtube }}" style="color: var(--gold-dark);">Helix Center YouTube channel</a>, spanning {{ roundtables[roundtables.length - 1].year }}&ndash;{{ roundtables[0].year }}.
    </p>
    {% endif %}

    <div class="listing-grid">
      {% for rt in items %}
      {% include "partials/roundtable-card.njk" %}
      {% endfor %}
    </div>

    <div class="pagination" id="rt-pagination">
    {% if pagination.pages | length > 1 %}
      {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">&laquo; Prev</a>
      {% endif %}
      {% for pageEntry in pagination.pages %}
      {% if pagination.pageNumber == loop.index0 %}
      <span class="current">{{ loop.index }}</span>
      {% else %}
      <a href="{{ pagination.hrefs[loop.index0] }}">{{ loop.index }}</a>
      {% endif %}
      {% endfor %}
      {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Next &raquo;</a>
      {% endif %}
    {% endif %}
    </div>

    <div style="text-align: center; margin-top: 1.5rem;">
      <a href="/roundtables/all/" style="font-size: 0.85rem; color: var(--gold-dark);">View all {{ roundtables | length }} roundtables &rarr;</a>
    </div>
  </div>
</section>
{% if isFirstPage %}
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Register modal open/close
  const openBtn = document.getElementById('register-open-btn');
  const overlay = document.getElementById('register-modal-overlay');
  if (openBtn && overlay) {
    openBtn.addEventListener('click', (e) => {
      e.preventDefault();
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    });
    const close = () => { overlay.classList.remove('show'); document.body.style.overflow = ''; };
    overlay.querySelector('.register-modal-close')?.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay.classList.contains('show')) close(); });
  }

  // Add to Calendar (.ics download)
  const calBtn = document.getElementById('add-to-calendar-btn');
  if (calBtn) {
    calBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const title = calBtn.dataset.title;
      const dateStr = calBtn.dataset.date;
      const location = calBtn.dataset.location;

      // Parse date like "March 7, 2026"
      const d = new Date(dateStr);
      // Default time: 2:30 PM ET, duration 2 hours
      d.setHours(14, 30, 0, 0);
      const end = new Date(d.getTime() + 2 * 60 * 60 * 1000);

      const fmt = (dt) => dt.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');

      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Helix Center//Events//EN',
        'BEGIN:VEVENT',
        'DTSTART:' + fmt(d),
        'DTEND:' + fmt(end),
        'SUMMARY:' + title,
        'LOCATION:' + location,
        'DESCRIPTION:Free interdisciplinary roundtable discussion at The Helix Center. All events are free and open to the public.',
        'URL:https://www.helixcenter.org/roundtables/',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = title.replace(/[^a-zA-Z0-9 ]/g, '').replace(/\s+/g, '-').toLowerCase() + '.ics';
      a.click();
      URL.revokeObjectURL(url);
    });
  }

  // Notify form (Netlify Forms) with email validation
  const notifyForm = document.getElementById('register-notify-form');
  const thankYou = document.getElementById('register-thank-you');
  if (notifyForm && thankYou) {
    notifyForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('register-email');
      const emailError = document.getElementById('register-email-error');
      const email = emailInput ? emailInput.value.trim() : '';

      // Validate email
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        if (emailError) emailError.style.display = 'block';
        if (emailInput) { emailInput.style.borderColor = '#c0392b'; emailInput.focus(); }
        return;
      }
      if (emailError) emailError.style.display = 'none';
      if (emailInput) emailInput.style.borderColor = 'var(--border)';

      const btn = notifyForm.querySelector('button');
      btn.textContent = 'Sending...';
      btn.disabled = true;
      const formData = new URLSearchParams(new FormData(notifyForm)).toString();
      fetch(window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData,
      }).then(res => {
        if (res.ok) { notifyForm.style.display = 'none'; thankYou.style.display = 'block'; }
        else { btn.textContent = 'Try Again'; btn.disabled = false; }
      }).catch(() => { btn.textContent = 'Try Again'; btn.disabled = false; });
    });
  }
});
</script>
