---
layout: layouts/base.njk
title: Roundtable Archive
pagination:
  data: roundtables
  size: 18
  alias: items
permalink: "/roundtables/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  pageTitle: "Roundtable Discussions{% if pagination.pageNumber > 0 %} — Page {{ pagination.pageNumber + 1 }}{% endif %}"
  description: "Browse {{ roundtables | length }}+ interdisciplinary roundtable discussions from The Helix Center{% if pagination.pageNumber > 0 %} — page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}{% endif %}. Featuring Nobel laureates and {{ site.stats.speakers }} distinguished scholars. All free to watch."
  breadcrumbSection: "Roundtables"
---

<div class="page-header">
  <div class="container">
    <div class="section-label">Archive</div>
    <h1>Roundtable Discussions</h1>
    <div class="gold-divider"></div>
    <p class="section-subtitle">{{ roundtables | length }} interdisciplinary discussions spanning {{ site.stats.seasons }} seasons, all free and open to the public</p>
  </div>
</div>

<div class="breadcrumbs">
  <ol><li><a href="/">Home</a></li><li>Roundtables</li></ol>
</div>

<section>
  <div class="container">
    {% set rtWithVideo = roundtables | where("hasVideo", true) %}
    <p style="font-family: var(--serif); font-size: 1.02rem; color: var(--text-mid); margin-bottom: 0.5rem;">
      {{ rtWithVideo | length }} roundtable recordings on the <a href="https://www.youtube.com/@helixcenter" style="color: var(--gold-dark);">Helix Center YouTube channel</a>, spanning {{ roundtables[roundtables | length - 1].year }}&ndash;{{ roundtables[0].year }}.
    </p>

    <div class="filter-bar">
      <input type="text" id="search-input" placeholder="Search roundtables by title, topic, or speaker...">
      <select id="filter-select">
        <option value="">All Years</option>
        {% for year in roundtables | uniqueValues('year') | reverse %}
        <option value="{{ year }}">{{ year }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="listing-grid">
      {% for rt in items %}
      {% include "partials/roundtable-card.njk" %}
      {% endfor %}
    </div>

    {% if pagination.pages | length > 1 %}
    <div class="pagination">
      {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">&laquo; Prev</a>
      {% endif %}
      {% for pageEntry in pagination.pages %}
      {% if pagination.pageNumber == loop.index0 %}
      <span class="current">{{ loop.index }}</span>
      {% else %}
      <a href="{{ pagination.hrefs[loop.index0] }}">{{ loop.index }}</a>
      {% endif %}
      {% endfor %}
      {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Next &raquo;</a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>
