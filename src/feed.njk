---
permalink: /feed/index.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
  xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>The Helix Center Roundtable Discussions</title>
    <link>{{ site.url }}/roundtables/</link>
    <atom:link href="{{ site.url }}/feed/index.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.description | xmlEscape }}</description>
    <language>en-us</language>
    <copyright>{{ site.name }}</copyright>
    <lastBuildDate>{{ "now" | rfc2822Date }}</lastBuildDate>
    <managingEditor>info@thehelixcenter.org ({{ site.shortName }})</managingEditor>
    <webMaster>info@thehelixcenter.org ({{ site.shortName }})</webMaster>
    <image>
      <url>{{ site.url }}/img/helix-center-og.jpg</url>
      <title>The Helix Center Roundtable Discussions</title>
      <link>{{ site.url }}/roundtables/</link>
    </image>
    <itunes:author>{{ site.shortName }}</itunes:author>
    <itunes:summary>{{ site.description | xmlEscape }}</itunes:summary>
    <itunes:owner>
      <itunes:name>{{ site.shortName }}</itunes:name>
      <itunes:email>info@thehelixcenter.org</itunes:email>
    </itunes:owner>
    <itunes:category text="Science"/>
    <itunes:category text="Society &amp; Culture">
      <itunes:category text="Philosophy"/>
    </itunes:category>
    <itunes:explicit>false</itunes:explicit>
    <itunes:image href="{{ site.url }}/img/helix-center-og.jpg"/>
    {% for ep in podcastFeed %}
    <item>
      <title>{{ ep.title | xmlEscape }}</title>
      <link>{{ site.url }}{{ ep.roundtableLink | replace("https://www.helixcenter.org", "") }}</link>
      <guid isPermaLink="false">{{ site.url }}/podcast/{{ ep.title | slug }}</guid>
      <pubDate>{{ ep.date | rfc2822Date }}</pubDate>
      <description>{{ ep.description | xmlEscape }}</description>
      <enclosure url="{{ ep.resolvedAudioUrl }}" type="audio/mpeg"/>
      {% if ep.duration %}<itunes:duration>{{ ep.duration }}</itunes:duration>{% endif %}
      <itunes:author>{{ site.shortName }}</itunes:author>
      <itunes:summary>{{ ep.description | xmlEscape }}</itunes:summary>
    </item>
    {% endfor %}
  </channel>
</rss>
