---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
excludeFromSitemap: true
---
{#-
  Sitemap.

  Static/standalone pages are derived from `collections.all` rather than a
  hand-maintained list. The previous hand-maintained `staticPages` array had
  drifted: it advertised /media/ (no such page has ever existed) while omitting
  /commentaries/, /institutions/, /topics/ and the individual blog posts.

  The speaker / roundtable / institution detail pages are generated by
  `pagination` with size 1, so `collections.all` holds only ONE entry per such
  template (not one per output page). Those three sets must therefore still be
  emitted by looping the source data directly.

  Excluded everywhere: `excludeFromSitemap`, `noindex` pages, the 404 page, and
  the paginated /page/N/ index views (page 1 is the canonical).
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.w3.org/2000/sitemaps.org/schemas/sitemap/0.9">
  {%- set today = "" | toISODate %}
  {%- set detailPrefixes = ["/speakers/", "/roundtables/", "/institutions/"] %}
  {%- for item in collections.all %}
  {%- set url = item.url %}
  {%- if url
        and not item.data.excludeFromSitemap
        and not item.data.noindex
        and not ("/page/" in url)
        and not url.endsWith("404.html") %}
  {#- Skip the single representative entry each paginated detail template
      contributes; those sets are emitted in full by the loops below. -#}
  {%- set isPaginatedDetail = false %}
  {%- for prefix in detailPrefixes %}
    {%- if url.startsWith(prefix) and url != prefix and not url.endsWith("/all/") and item.data.pagination %}
      {%- set isPaginatedDetail = true %}
    {%- endif %}
  {%- endfor %}
  {%- if not isPaginatedDetail %}
  <url>
    <loc>{{ site.url }}{{ url }}</loc>
    <lastmod>{{ today }}</lastmod>
    {%- if url == "/" %}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    {%- else %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endif %}
  {%- endfor %}
  {#- Indexable pages that set `eleventyExcludeFromCollections`, so never reach
      collections.all and must be named explicitly. Keep this list short. -#}
  {%- set collectionExcludedPages = ["/commentaries/"] %}
  {%- for pg in collectionExcludedPages %}
  <url>
    <loc>{{ site.url }}{{ pg }}</loc>
    <lastmod>{{ today }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
  {%- for speaker in speakers %}
  <url>
    <loc>{{ site.url }}/speakers/{{ speaker.slug }}/</loc>
    <lastmod>{{ today }}</lastmod>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
  {%- for rt in roundtables %}
  <url>
    <loc>{{ site.url }}/roundtables/{{ rt.slug }}/</loc>
    <lastmod>{% if rt.date %}{{ rt.date | toISODate }}{% else %}{{ today }}{% endif %}</lastmod>
    <priority>0.7</priority>
  </url>
  {%- endfor %}
  {%- for inst in institutions %}
  <url>
    <loc>{{ site.url }}/institutions/{{ inst.slug }}/</loc>
    <lastmod>{{ today }}</lastmod>
    <priority>0.5</priority>
  </url>
  {%- endfor %}
</urlset>
