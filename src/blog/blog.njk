---
layout: layouts/base.njk
title: Blog
pageTitle: "From the Director's Desk"
description: "Reflections on interdisciplinary investigation, roundtable highlights, and the intellectual life of The Helix Center by Founder & Director Dr. Edward Nersessian."
permalink: /blog/
breadcrumbSection: "Blog"
---

<div class="page-header">
  <div class="container">
    <div class="section-label">Director's Reflections</div>
    <h1>From the Director's Desk</h1>
    <div class="gold-divider"></div>
    <p class="section-subtitle">Reflections on interdisciplinary investigation by Dr. Edward Nersessian</p>
  </div>
</div>

<div class="breadcrumbs">
  <ol><li><a href="/">Home</a></li><li>Blog</li></ol>
</div>

<section>
  <div class="container">
    {% if posts and posts.length %}
    <div class="blog-list">
      {% for post in posts | reverse %}
      <article class="blog-card" style="margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-light, #e8e0d4);">
        <div class="media-meta">{{ post.date | formatDate }}</div>
        <h2 style="margin: 0.5rem 0;"><a href="/blog/{{ post.slug }}/" style="color: inherit; text-decoration: none;">{{ post.title }}</a></h2>
        {% if post.subtitle %}
        <p style="font-family: var(--serif); font-size: 1.05rem; color: var(--text-mid); font-style: italic; margin: 0.25rem 0 0.75rem;">{{ post.subtitle }}</p>
        {% endif %}
        {% if post.excerpt %}
        <p style="font-family: var(--serif); font-size: 0.95rem; color: var(--text-mid); line-height: 1.7;">{{ post.excerpt }}</p>
        {% endif %}
        <a href="/blog/{{ post.slug }}/" style="font-size: 0.85rem; color: var(--gold-dark, #8B7355);">Read more &rarr;</a>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div style="text-align: center; padding: 4rem 1rem;">
      <p style="font-family: var(--serif); font-size: 1.1rem; color: var(--text-mid);">New reflections coming soon.</p>
    </div>
    {% endif %}
  </div>
</section>
