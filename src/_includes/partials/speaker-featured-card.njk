<div class="upcoming-card speaker-featured">
  <div class="speaker-featured-photo" style="display: flex; align-items: center; justify-content: center; background: var(--navy);">
    {% if speaker.photo %}
    <img src="{{ speaker.photo }}" alt="{{ speaker.name }}" style="width: 100%; height: 100%; object-fit: cover;">
    {% else %}
    <div style="font-family: var(--serif); font-size: 4rem; font-weight: 700; color: var(--gold);">{{ speaker.name | initials }}</div>
    {% endif %}
  </div>
  <div class="upcoming-card-body">
    {% if rtTitle %}
    <a href="/roundtables/{{ rtSlug }}/" style="text-decoration: none;">
      <div class="upcoming-card-date" style="margin-bottom: 0.15rem;">{{ rtTitle }}</div>
    </a>
    {% if rtDate %}
    <div style="font-size: 0.8rem; color: var(--text-dark); margin-bottom: 0.75rem;">{{ rtDate }}</div>
    {% endif %}
    {% endif %}
    <a href="/speakers/{{ speaker.slug }}/" style="text-decoration: none; color: inherit;">
      <h3 class="upcoming-card-title">{{ speaker.name }}</h3>
    </a>
    {% if speaker.title %}
    <p style="font-size: 0.9rem; color: var(--gold-dark); margin-bottom: 0.5rem;">{{ speaker.title }}</p>
    {% elif speaker.institution and speaker.institution != "Unknown" %}
    <p style="font-size: 0.9rem; color: var(--gold-dark); margin-bottom: 0.5rem;">{{ speaker.institution }}</p>
    {% endif %}
    {% if speaker.bio %}
    <p class="upcoming-card-desc">{{ speaker.bio }}</p>
    {% elif speaker.achievement %}
    <p class="upcoming-card-desc">{{ speaker.achievement }}</p>
    {% endif %}
    {% if speaker.domain %}
    <div class="rt-tags" style="margin-top: 0.75rem;">
      <a href="/speakers/all/?domain={{ speaker.domain | urlencode }}" class="rt-tag">{{ speaker.domain }}</a>
    </div>
    {% endif %}
  </div>
</div>
