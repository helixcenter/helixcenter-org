<a href="/roundtables/{{ rt.slug }}/" class="rt-card" data-searchable="{{ rt.title }} {{ rt.description }} {{ rt.speakers | join(' ') }}" data-category="{{ rt.year }}">
  {% if rt.imageFile %}
  <img src="{{ rt.imageFile }}" alt="{{ rt.title }}" class="rt-thumbnail" loading="lazy" width="400" height="225">
  {% endif %}
  <div class="rt-date">{{ rt.date }}{% if rt.hasAudio %} &middot; <span class="rt-media-badge">&#9654; Audio</span>{% endif %}</div>
  <div class="rt-title">{{ rt.title }}</div>
  {% if rt.description %}
  <div class="rt-desc">{{ rt.description | truncate(180) }}</div>
  {% endif %}
  {% if rt.tags and rt.tags.length %}
  <div class="rt-tags">
    {% for tag in rt.tags | limit(3) %}
    <span class="rt-tag">{{ tag }}</span>
    {% endfor %}
  </div>
  {% endif %}
  {% if rt.speakers and rt.speakers.length %}
  <div class="rt-speakers">{{ rt.speakers | join(', ') }}</div>
  {% endif %}
</a>
