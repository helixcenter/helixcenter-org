{%- if breadcrumbSection %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ breadcrumbSection }}",
      "item": "{{ site.url }}/{{ breadcrumbSection | slug }}/"
    }
    {%- if breadcrumbPage %},
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ breadcrumbPage }}"
    }
    {%- endif %}
  ]
}
</script>
{%- endif %}
