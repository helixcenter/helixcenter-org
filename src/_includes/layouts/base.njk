<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle or title }} | {{ site.shortName }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">

<!-- Open Graph -->
<meta property="og:title" content="{{ pageTitle or title }} | {{ site.shortName }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.shortName }}">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="{{ ogImage or site.url + '/img/helix-center-og.jpg' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@HelixCenter">
<meta name="twitter:title" content="{{ pageTitle or title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ ogImage or site.url + '/img/helix-center-og.jpg' }}">

<!-- Additional SEO -->
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">{% endif %}
<meta name="author" content="{{ site.name }}">
<meta name="geo.placename" content="New York, NY">
<meta name="geo.region" content="US-NY">
{%- if datePublished %}
<meta property="article:published_time" content="{{ datePublished | toISODate }}">
{%- endif %}
{%- if dateModified %}
<meta property="article:modified_time" content="{{ dateModified | toISODate }}">
{%- endif %}
{%- if bingVerification %}
<meta name="msvalidate.01" content="{{ bingVerification }}">
{%- endif %}

<!-- Pagination -->
{%- if pagination %}
{%- if pagination.href.previous %}
<link rel="prev" href="{{ site.url }}{{ pagination.href.previous }}">
{%- endif %}
{%- if pagination.href.next %}
<link rel="next" href="{{ site.url }}{{ pagination.href.next }}">
{%- endif %}
{%- endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
</head>
<body>

{% include "partials/nav.njk" %}

<div class="nav-mobile" id="mobile-nav">
  <a href="/about/">About</a>
  <a href="/speakers/">Speakers</a>
  <a href="/roundtables/">Roundtables</a>
  <a href="/disciplines/">Disciplines</a>
  <a href="/topics/">Topics</a>
  <a href="/leadership/">Leadership</a>
  <a href="/donate/">Donate</a>
</div>

{% include "partials/breadcrumb-schema.njk" %}

{{ content | safe }}

<!-- Donate Modal -->
<div class="donate-modal-overlay" id="donate-modal-overlay">
  <div class="stat-modal" style="max-width: 480px;">
    <button class="stat-modal-close" id="donate-modal-close">&times;</button>
    <div style="text-align: center; padding: 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">&#10084;</div>
      <h2 style="font-family: var(--serif); font-size: 1.5rem; color: var(--navy); margin-bottom: 0.75rem;">Thank You for Your Generosity</h2>
      <p style="font-family: var(--serif); font-size: 1rem; color: var(--text-mid); line-height: 1.7; margin-bottom: 1.5rem;">
        You will be taken to The Helix Center's secure donation page. All donations are tax-deductible under our 501(c)(3) status.
      </p>
      <a href="https://www.helixcenter.org/donate/" class="btn btn-gold" target="_blank" rel="noopener" style="display: inline-block; font-size: 1rem; padding: 0.85rem 2.5rem;">Continue to Donate</a>
      <p style="font-size: 0.78rem; color: var(--text-light); margin-top: 1rem;">
        Secure payment processing on helixcenter.org
      </p>
    </div>
  </div>
</div>

{% include "partials/footer.njk" %}

<script src="/js/main.js" defer></script>
</body>
</html>
